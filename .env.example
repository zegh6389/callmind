# CallMind gateway config. Copy to .env and fill in.
# All vars use the CALLMIND_ prefix.

# --- Gateway ---
CALLMIND_HOST=0.0.0.0
CALLMIND_PORT=8000

# --- Telephony ---
# telnyx | twilio
CALLMIND_TELEPHONY_PROVIDER=telnyx

# --- STT (faster-whisper) ---
# small = fastest; medium = better accuracy if latency budget allows.
CALLMIND_STT_MODEL_SIZE=small
# auto | cuda | cpu
# NOTE: ctranslate2 Windows wheels are CPU-only. For GPU STT run on
# Linux/WSL2 with CUDA, or keep cpu+int8 (small model is usable).
CALLMIND_STT_DEVICE=auto
# auto | int8 | float16 | int8_float16
CALLMIND_STT_COMPUTE_TYPE=auto
# null = auto-detect language
CALLMIND_STT_LANGUAGE=

# --- VAD (energy-based) ---
# Speech threshold in dBFS. Raise if background noise triggers speech.
CALLMIND_VAD_ENERGY_DBFS=-45.0
# Consecutive active frames (20ms each) to confirm speech start.
CALLMIND_VAD_START_FRAMES=3
# Consecutive silent frames to mark end of utterance (25 = 500ms).
CALLMIND_VAD_END_FRAMES=25
# Drop utterances shorter than this.
CALLMIND_VAD_MIN_SPEECH_MS=200

# --- MiniMax LLM ---
CALLMIND_LLM_API_KEY=
CALLMIND_LLM_BASE_URL=https://api.minimax.io/v1
CALLMIND_LLM_ENDPOINT=/text/chatcompletion_v2
# TODO: verify model name in MiniMax console.
CALLMIND_LLM_MODEL=MiniMax-Text-01
CALLMIND_LLM_MAX_TOKENS=300
CALLMIND_LLM_TEMPERATURE=0.7
# Turns of conversation kept in short-term memory.
CALLMIND_MEMORY_WINDOW=8

# --- MiniMax TTS ---
CALLMIND_TTS_API_KEY=
CALLMIND_TTS_BASE_URL=https://api.minimax.io/v1
CALLMIND_TTS_ENDPOINT=/t2a_v2
# TODO: verify model name. Use Flash/Turbo only; HD is too slow for realtime.
CALLMIND_TTS_MODEL=speech-2.8-flash
# TODO: set a voice_id from the MiniMax console.
CALLMIND_TTS_VOICE_ID=
CALLMIND_TTS_SAMPLE_RATE=24000
CALLMIND_TTS_SPEED=1.0
CALLMIND_TTS_VOLUME=1.0
CALLMIND_TTS_PITCH=0

# --- Call behavior ---
CALLMIND_GREETING=Hi, thanks for calling. How can I help you today?
